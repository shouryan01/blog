{
  "name": "blog",
  "version": "1.0.0",
  "description": "Personal blog built with Next.js and Hashnode API",
  "private": true,
  "keywords": [
    "blog",
    "nextjs",
    "hashnode",
    "typescript"
  ],
  "license": "MIT",
  "author": "",
  "scripts": {
    "build": "next build",
    "codegen": "graphql-codegen --config codegen.yml",
    "dev": "concurrently \"next\" \"pnpm codegen --watch\" --names next,codegen",
    "start": "next start",
    "typecheck": "tsc",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-select": "^2.2.6",
    "@types/prismjs": "^1.26.5",
    "@vercel/og": "^0.5.18",
    "classnames": "^2.3.1",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "eslint-config-next": "^15.5.3",
    "graphql-request": "^6.1.0",
    "gray-matter": "^4.0.3",
    "html-react-parser": "^4.2.2",
    "js-base64": "^3.7.5",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.545.0",
    "next": "^15.5.3",
    "next-themes": "^0.3.0",
    "prismjs": "^1.29.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.3.0",
    "react-snowfall": "^2.3.0",
    "react-waypoint": "^10.3.0",
    "remark": "^14.0.2",
    "remark-html": "^15.0.1",
    "rss": "^1.2.2",
    "sanitize-html": "^2.11.0",
    "slug": "^8.2.3",
    "tailwind-merge": "^1.13.2",
    "uuid": "^9.0.1",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/typed-document-node": "^5.0.1",
    "@graphql-codegen/typescript": "^4.0.1",
    "@graphql-codegen/typescript-operations": "^4.0.1",
    "@parcel/watcher": "^2.3.0",
    "@tailwindcss/typography": "^0.5.10",
    "@types/js-cookie": "^3.0.4",
    "@types/node": "^18.0.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/rss": "^0.0.30",
    "@types/sanitize-html": "^2.9.0",
    "@types/slug": "^5.0.9",
    "@types/uuid": "^9.0.5",
    "autoprefixer": "^10.4.7",
    "concurrently": "^8.2.1",
    "postcss": "^8.4.14",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
